# Database (Postgres — e.g. Vercel Postgres, Neon, Supabase, Railway)
DATABASE_URL="postgresql://user:password@host:5432/clarityclaim"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google Gemini (multi-agent claim pipeline) — free key from aistudio.google.com
GEMINI_API_KEY="..."

# UploadThing (claim evidence uploads)
UPLOADTHING_TOKEN="..."

# Upstash (background job queue for the agent pipeline)
QSTASH_TOKEN="..."
QSTASH_CURRENT_SIGNING_KEY="..."
QSTASH_NEXT_SIGNING_KEY="..."
UPSTASH_REDIS_REST_URL="..."
UPSTASH_REDIS_REST_TOKEN="..."
